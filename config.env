# Knobs for the build pipeline. Override on the make command line, e.g.
#   make linux-arm64 AOSP_BRANCH=platform-tools-36.0.0

# Git tag applied to every cloned AOSP project repo. Use a release
# tag (not a branch) for reproducibility. lzhiyong's project pins
# platform-tools-35.0.2; we match.
AOSP_BRANCH=platform-tools-35.0.2

# What build-tools version label the artifacts correspond to. This is
# just metadata used when packaging; it does NOT change what's built.
BUILD_TOOLS_LABEL=35.0.2

# Number of parallel jobs. Empty -> auto-detect from container CPUs.
JOBS=

# Where ccache lives on the host (persisted between runs).
CCACHE_DIR=./.ccache

# Binaries to build. MVP scope is aapt2; the other tools (aapt, aidl,
# dexdump, split-select, zipalign) get added as each one passes a
# clean build in the new pipeline.
TARGETS=aapt2

# llvm-mingw release used for the (still-Soong-based, still-broken)
# windows-arm64 path. Kept here so the variable doesn't disappear from
# the API; the windows-arm64 target will be rewritten the same way as
# linux-arm64 in a later pass.
LLVM_MINGW_VERSION=20240619
