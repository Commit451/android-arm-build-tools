# Knobs for the build pipeline. Override on the make command line, e.g.
#   make linux-arm64 AOSP_BRANCH=android-14.0.0_r1

# AOSP tag or branch to check out. Use a release tag for reproducibility.
# Find tags at https://android.googlesource.com/platform/manifest/+refs
AOSP_BRANCH=android-15.0.0_r1

# What build-tools version label the artifacts correspond to. This is
# just metadata used when packaging; it does NOT change what's built.
BUILD_TOOLS_LABEL=35.0.0

# Number of parallel jobs. Empty -> auto-detect from container CPUs.
JOBS=

# Where ccache lives on the host (persisted between runs).
CCACHE_DIR=./.ccache

# llvm-mingw release used for Windows ARM64 cross-compile.
# See https://github.com/mstorsjo/llvm-mingw/releases
LLVM_MINGW_VERSION=20240619
LLVM_MINGW_SHA256=  # optional, set to enforce checksum

# Soong targets to build. These names must match the module names in
# the AOSP source tree's Android.bp files.
SOONG_TARGETS=aapt aapt2 aidl dexdump split-select zipalign
