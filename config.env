# Knobs for the build pipeline. Override on the make command line, e.g.
#   make linux-arm64 AOSP_BRANCH=platform-tools-36.0.0

# Git ref cloned for every AOSP project repo. Used as the default
# when invoking `make linux-arm64` without overrides — CI dispatches
# pass AOSP_BRANCH/BUILD_TOOLS_LABEL explicitly via the resolver in
# scripts/check_upstream.py, so these defaults only affect local dev.
#
# Pinned to the latest verified build (Android 16 QPR1 = build-tools
# 36.1.0). For other versions, see the KNOWN_MAPPINGS table in
# scripts/check_upstream.py and pass overrides on the make line, e.g.:
#   make linux-arm64 AOSP_BRANCH=android-16.0.0_r1 BUILD_TOOLS_LABEL=36.0.0
AOSP_BRANCH=android-16.0.0_r3

# What build-tools version label the artifacts correspond to. This is
# just metadata used when packaging; it does NOT change what's built.
BUILD_TOOLS_LABEL=36.1.0

# Number of parallel jobs. Empty -> auto-detect from container CPUs.
JOBS=

# Where ccache lives on the host (persisted between runs).
CCACHE_DIR=./.ccache

# Binaries to build. The four that are actually used by a normal
# Android app build path:
#   aapt2       — compile/link Android resources (every build)
#   zipalign    — APK alignment (every release build)
#   aidl        — AIDL stub generation (if the app declares IPC)
#   split-select— used by AGP for AAB / split-APK delivery
#
# Dropped: aapt (legacy, unused by AGP 3.0+) and dexdump (debug-only,
# never invoked by the build pipeline, drags in src/art/).
TARGETS=aapt2 aidl zipalign split-select
