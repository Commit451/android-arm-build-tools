# Project: src/base
# AssetsProvider.cpp uses C++20 designated initializers to set st_mtime
# on a struct stat:
#
#     struct stat sb{.st_mtime = -1};
#
# That works on bionic where st_mtime is a direct field of struct stat.
# glibc defines st_mtime as a macro that expands to st_mtim.tv_sec
# (timespec field), so after preprocessing the designator becomes
# nested (.st_mtim.tv_sec) which isn't valid C++20 designated init.
#
# Rewrite as zero-init + assignment, which goes through the macro
# expansion exactly the way it does everywhere else in the file.
diff --git a/libs/androidfw/AssetsProvider.cpp b/libs/androidfw/AssetsProvider.cpp
--- a/libs/androidfw/AssetsProvider.cpp
+++ b/libs/androidfw/AssetsProvider.cpp
@@ -104,7 +104,8 @@ std::unique_ptr<ZipAssetsProvider> ZipAssetsProvider::Create(std::string path,
     return {};
   }

-  struct stat sb{.st_mtime = -1};
+  struct stat sb = {};
+  sb.st_mtime = -1;
   // Skip all up-to-date checks if the file won't ever change.
   if (!isReadonlyFilesystem(path.c_str())) {
     if ((released_fd < 0 ? stat(path.c_str(), &sb) : fstat(released_fd, &sb)) < 0) {
@@ -137,7 +138,8 @@ std::unique_ptr<ZipAssetsProvider> ZipAssetsProvider::Create(base::unique_fd fd,
     return {};
   }

-  struct stat sb{.st_mtime = -1};
+  struct stat sb = {};
+  sb.st_mtime = -1;
