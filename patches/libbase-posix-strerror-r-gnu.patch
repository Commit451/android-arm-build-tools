# Project: src/libbase
# Handle GNU strerror_r() (returns char*) in addition to the POSIX
# variant (returns int).
#
# The file already does `#undef _GNU_SOURCE` before including
# <string.h>, but our force-included shim cmake/shims/glibc_compat.h
# pulls in <atomic> -> <features.h> earlier, which locks
# _GNU_SOURCE / __USE_GNU before the file gets a chance to undef
# it. So glibc's strerror_r ends up declared as char*-returning
# and the bare `return strerror_r(...)` fails to convert.
#
# Rewrite the body to detect GNU semantics and normalize.
diff --git a/posix_strerror_r.cpp b/posix_strerror_r.cpp
--- a/posix_strerror_r.cpp
+++ b/posix_strerror_r.cpp
@@ -25,7 +25,17 @@ namespace base {
 extern "C" int posix_strerror_r(int errnum, char* buf, size_t buflen) {
 #ifdef _WIN32
   return strerror_s(buf, buflen, errnum);
+#elif defined(__GLIBC__) && defined(_GNU_SOURCE)
+  // glibc + _GNU_SOURCE -> GNU strerror_r returns char*. Normalize
+  // to POSIX semantics: copy into caller's buf if it isn't already
+  // there and return 0.
+  const char* r = strerror_r(errnum, buf, buflen);
+  if (r != buf && buflen > 0) {
+    strncpy(buf, r, buflen);
+    buf[buflen - 1] = '\0';
+  }
+  return 0;
 #else
   return strerror_r(errnum, buf, buflen);
 #endif
 }
