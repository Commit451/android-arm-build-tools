# Project: src/core
# packagelistparser.cpp uses two bionic-isms that aren't in glibc:
# - <sys/limits.h> header (glibc equivalent is plain <limits.h>)
# - GID_MAX constant (not defined in glibc; bionic has it as
#   the max possible gid_t value, i.e. (gid_t)-1)
diff --git a/libpackagelistparser/packagelistparser.cpp b/libpackagelistparser/packagelistparser.cpp
--- a/libpackagelistparser/packagelistparser.cpp
+++ b/libpackagelistparser/packagelistparser.cpp
@@ -23,12 +23,16 @@
 #include <stdio.h>
 #include <stdlib.h>
 #include <string.h>
-#include <sys/limits.h>
+#include <limits.h>

 #include <memory>

 #include <log/log.h>

+#ifndef GID_MAX
+#define GID_MAX ((gid_t)-1)
+#endif
+
 static bool parse_gids(const char* path, size_t line_number, const char* gids, pkg_info* info) {
   // Nothing to do?
   if (!gids || !strcmp(gids, "none")) return true;
